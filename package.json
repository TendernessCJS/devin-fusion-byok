{
  "name": "devin-fusion-byok",
  "displayName": "Devin Fusion BYOK",
  "description": "Import OpenAI- and Anthropic-compatible models into Devin Local and native Fusion through runtime bridges.",
  "version": "0.6.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TendernessCJS/devin-fusion-byok.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.cjs",
  "activationEvents": [
    "*"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "mcp:fast-context": "node src/fast-context/server.cjs",
    "package": "node scripts/package.cjs",
    "verify": "node scripts/verify-install.cjs",
    "vscode:uninstall": "node src/lifecycle/uninstall.cjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "devinFusionByok.checkUpdates",
        "title": "%command.checkUpdates.title%"
      },
      {
        "command": "devinFusionByok.openPanel",
        "title": "%command.openPanel.title%"
      },
      {
        "command": "devinFusionByok.refreshModels",
        "title": "%command.refreshModels.title%"
      },
      {
        "command": "devinFusionByok.selectFusion",
        "title": "%command.selectFusion.title%"
      },
      {
        "command": "devinFusionByok.contextDetails",
        "title": "%command.contextDetails.title%"
      },
      {
        "command": "devinFusionByok.fastContextMcp",
        "title": "%command.fastContextMcp.title%"
      },
      {
        "command": "devinFusionByok.goal",
        "title": "%command.goal.title%"
      },
      {
        "command": "devinFusionByok.status",
        "title": "%command.status.title%"
      },
      {
        "command": "devinFusionByok.disable",
        "title": "%command.disable.title%"
      }
    ]
  }
}
